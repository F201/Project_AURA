{
  "name": "aura-desktop",
  "version": "1.1.0",
  "description": "AURA Live Desktop Companion — Live2D & 3D VRM/GLB overlay with local STT/TTS, native vision, function-calling expressions, and persistent memory",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5174 && electron . --dev\"",
    "dev:web": "vite",
    "build": "vite build",
    "build:electron": "vite build && electron-builder",
    "start": "electron .",
    "test": "node node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@pixiv/three-vrm": "^3.3.6",
    "livekit-client": "^2.17.1",
    "lucide-react": "^0.475.0",
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^7.4.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.0.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.1",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.aura.desktop",
    "productName": "AURA Desktop",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/**",
      "public/**"
    ]
  }
}
