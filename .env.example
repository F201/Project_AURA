# --- LLM CONFIGURATION ---
# OpenRouter API Key - Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional: Direct provider keys (used when provider != openrouter)
ANTHROPIC_API_KEY=          # Required for claude-* models
GROQ_API_KEY=               # Required for Groq provider (fast Llama/Mixtral)
OLLAMA_BASE_URL=http://localhost:11434   # Local Ollama endpoint

# --- VOICE CONFIGURATION (LIVEKIT AGENTS) ---
# Deepgram API Key (STT) - Get yours at https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_key_here

# TTS Provider - Use 'qwen' for local GPU, 'cartesia' or 'openai' for cloud
TTS_TYPE=qwen

# Cartesia API Key (TTS) - Get yours at https://play.cartesia.ai/
CARTESIA_API_KEY=your_cartesia_key_here

# --- VTUBE STUDIO CONFIGURATION ---
# Set to 'true' to enable facial expressions (requires VTube Studio to be open)
VTUBE_ENABLED=false

# --- DATABASE / MEMORY CONFIGURATION ---
# Supabase Project Details - Get yours at https://supabase.com/
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# --- DASHBOARD CONFIGURATION ---
# These are exposed to the frontend (Vite)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- LIVEKIT CLOUD CONFIGURATION ---
# Get these from your LiveKit Cloud Project Settings (https://cloud.livekit.io/)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- DESKTOP LIVE COMPANION AGENT (OPTIONAL) ---
# Runs locally on http://127.0.0.1:8765 alongside desktop/
DESKTOP_LLM_MODEL=deepseek/deepseek-v4-flash
DESKTOP_AGENT_HOST=127.0.0.1
DESKTOP_AGENT_PORT=8765
USER_NAME=Friend
STT_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
TTS_CHUNK_SIZE=6
TTS_LANGUAGE=English
VISION_ENABLED=true
PROACTIVE_ENABLED=true
PROACTIVE_COOLDOWN_SEC=180
